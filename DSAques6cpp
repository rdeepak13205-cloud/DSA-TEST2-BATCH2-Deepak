//find the first repeated roll number
#include <iostream>
using namespace std;
int main(){
    int a[] = {1, 2, 3, 1};
    int n = 4;
 for(int i = 0; i < n; i++){
        for(int j = i + 1; j < n; j++){
            if(a[i] == a[j]){
                cout << "true";
                return 0;
            }
        }
    }
    cout << "false";
    return 0;
}
// Time Complexity: O(n^2)